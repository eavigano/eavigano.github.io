```{=html}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/academicons@1.9.1/css/academicons.min.css">

<ul class="paper-list">
  <% for (const item of items) { %>
    <%
      // Resource links, most useful first. Each entry renders only if the
      // corresponding key is present in papers.yaml.
      const resources = [];
      if (item.pdf)       resources.push({ href: item.pdf,       icon: 'bi bi-file-earmark-pdf',   label: 'PDF' });
      if (item.pubopen)   resources.push({ href: item.pubopen,   icon: 'ai ai-open-access',        label: 'Open access' });
      if (item.pubclosed) resources.push({ href: item.pubclosed, icon: 'ai ai-closed-access',      label: 'Published version' });
      if (item.preprint)  resources.push({ href: item.preprint,  icon: 'ai ai-doi',                label: 'Preprint' });
      if (item.appendix)  resources.push({ href: item.appendix,  icon: 'bi bi-file-earmark-plus',  label: 'Appendix' });
      if (item.dataverse) resources.push({ href: item.dataverse, icon: 'ai ai-dataverse',          label: 'Replication data' });
      if (item.osf)       resources.push({ href: item.osf,       icon: 'ai ai-osf',                label: 'OSF' });
      if (item.github)    resources.push({ href: item.github,    icon: 'bi bi-github',             label: 'Code' });
      if (item.prereg)    resources.push({ href: item.prereg,    icon: 'ai ai-preregistered',      label: 'Pre-registration' });
      if (item.website)   resources.push({ href: item.website,   icon: 'bi bi-box-arrow-up-right', label: 'Project website' });
      if (item.errata)    resources.push({ href: item.errata,    icon: 'bi bi-exclamation-diamond', label: 'Errata' });
    %>
    <li class="paper" <%= metadataAttrs(item) %>>

      <div class="paper-title"><%= item.title %></div>

      <div class="paper-meta">
        <% if (item.author) { %><span class="paper-authors"><%= item.author %></span><% } %>
        <% if (item.type === 'Published') { %>
          <% if (item.journal) { %>
            <span class="paper-link-sep">&middot;</span>
            <span class="paper-journal"><%= item.journal %></span>
          <% } %>
          <% if (item.year) { %>
            <span class="paper-link-sep">&middot;</span>
            <span class="paper-year"><%= item.year %></span>
          <% } %>
        <% } else { %>
          <% if (item.status) { %>
            <span class="paper-link-sep">&middot;</span>
            <span class="paper-status"><%= item.status %></span>
          <% } %>
        <% } %>
      </div>

      <% if (resources.length) { %>
        <div class="paper-links">
          <% resources.forEach(function (res, i) { %>
            <% if (i > 0) { %><span class="paper-link-sep">&middot;</span><% } %>
            <a class="paper-link" href="<%= res.href %>">
              <i class="<%= res.icon %>" aria-hidden="true"></i><%= res.label %>
            </a>
          <% }); %>
        </div>
      <% } %>

      <% if (item.note) { %>
        <div class="paper-note"><%= item.note %></div>
      <% } %>

    </li>
  <% } %>
</ul>

```
